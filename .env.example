# Copy to .env and fill in. Never commit .env.
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_PRIMARY_MODEL=anthropic/claude-sonnet-5
NICRRON_SECONDARY_MODEL=openai/gpt-5.6-terra

# PRISM by Block Convey (optional; tracing + Guardrail are disabled when unset)
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism.blockconvey.com

# Google Cloud Vision (optional): exact evidence boxes from OCR. Without it the
# model's estimated boxes are used. Enable "Cloud Vision API" and create an API key.
GOOGLE_VISION_API_KEY=

# "Call prescriber". simulated (default): no real call is placed. elevenlabs: real outbound
# calls, only to numbers in RXBRIDGE_CALL_ALLOWLIST (comma-separated). See README.
RXBRIDGE_CALLER=simulated
RXBRIDGE_SIM_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
RXBRIDGE_CALL_ALLOWLIST=
